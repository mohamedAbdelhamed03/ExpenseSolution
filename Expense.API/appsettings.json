{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ExpenseDB;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    "Key": "ThisIsMySecretKeyForJwtTokenGenerationAndItShouldBeAtLeast32CharactersLong",
    "Issuer": "ExpenseAPI",
    "Audience": "ExpenseUsers",
    "ExpiryHours": 1,
    "ExpiryDays": 7,
    "ExpiryMinutes": 0
  }
}
